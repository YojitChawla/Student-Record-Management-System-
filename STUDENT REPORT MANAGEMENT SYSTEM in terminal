#include <stdio.h>
#include <string.h>

int id[100];
char name[100][50];
char course[100][50];
float marks[100];

int count = 0;

// Add Student
void add()
{
    if (count == 100) {
        printf("Record Full!\n");
        return;
    }

    printf("Enter ID: ");
    scanf("%d", &id[count]);

    printf("Enter Name: ");
    fflush(stdout);
    if (scanf("%49s", name[count]) != 1)
        return;

    printf("Enter Course: ");
    fflush(stdout);
    if (scanf("%49s", course[count]) != 1)
        return;

    printf("Enter Marks: ");
    scanf("%f", &marks[count]);

    count++;

    printf("Student Added!\n");
}

// Display Students
void display()
{
    int i;

    if (count == 0) {
        printf("No Records!\n");
        return;
    }

    for (i = 0; i < count; i++) {
        printf("\nID: %d\n", id[i]);
        printf("Name: %s\n", name[i]);
        printf("Course: %s\n", course[i]);
        printf("Marks: %.2f\n", marks[i]);
    }
}

// Recursive Search
int search(int sid, int i)
{
    if (i == count)
        return -1;

    if (id[i] == sid)
        return i;

    return search(sid, i + 1);
}

// Find Student
void find()
{
    int sid, i;

    printf("Enter ID: ");
    scanf("%d", &sid);

    i = search(sid, 0);

    if (i == -1) {
        printf("Not Found!\n");
    }
    else {
        printf("Name: %s\n", name[i]);
        printf("Course: %s\n", course[i]);
        printf("Marks: %.2f\n", marks[i]);
    }
}

// Update Student
void update()
{
    int sid, i;

    printf("Enter ID: ");
    scanf("%d", &sid);

    i = search(sid, 0);

    if (i == -1) {
        printf("Not Found!\n");
    }
    else {
        printf("Enter Name: ");
        fflush(stdout);
        if (scanf("%49s", name[i]) != 1)
            return;

        printf("Enter Course: ");
        fflush(stdout);
        if (scanf("%49s", course[i]) != 1)
            return;

        printf("Enter Marks: ");
        scanf("%f", &marks[i]);

        printf("Updated!\n");
    }
}

// Delete Student
void del()
{
    int sid, i, j;

    printf("Enter ID: ");
    scanf("%d", &sid);

    i = search(sid, 0);

    if (i == -1) {
        printf("Not Found!\n");
    }
    else {
        for (j = i; j < count - 1; j++) {
            id[j] = id[j + 1];

            strcpy(name[j], name[j + 1]);

            strcpy(course[j], course[j + 1]);

            marks[j] = marks[j + 1];
        }

        count--;

        printf("Deleted!\n");
    }
}

// Calculate Average
void average()
{
    int i;
    float total = 0;

    if (count == 0) {
        printf("No Records!\n");
        return;
    }

    for (i = 0; i < count; i++) {
        total += marks[i];
    }

    printf("Average: %.2f\n", total / count);
}

// Main Function
int main()
{
    int ch;

    do {
        printf("\n===== Student Record =====\n");

        printf("1. Add\n");
        printf("2. Display\n");
        printf("3. Search\n");
        printf("4. Update\n");
        printf("5. Delete\n");
        printf("6. Average\n");
        printf("0. Exit\n");

        printf("Enter Choice: ");
        scanf("%d", &ch);

        switch (ch) {
            case 1:
                add();
                break;

            case 2:
                display();
                break;

            case 3:
                find();
                break;

            case 4:
                update();
                break;

            case 5:
                del();
                break;

            case 6:
                average();
                break;

            case 0:
                printf("Thank You!\n");
                break;

            default:
                printf("Invalid Choice!\n");
        }

    } while (ch != 0);

    return 0;
}

