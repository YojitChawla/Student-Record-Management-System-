#include <stdio.h>
#include <string.h>

char id[100][50];
char name[100][50];
char course[100][50];
float marks[100];
int count = 0;

void add() {
    if (count == 100) {
        printf("Record Full!\n");
        return;
    }
    printf("Enter ID: ");
    if (scanf("%49s", id[count]) != 1) return;
    printf("Enter Name: ");
    fflush(stdout);
    if (scanf(" %49[^\n]", name[count]) != 1) return;
    printf("Enter Course: ");
    fflush(stdout);
    if (scanf(" %49[^\n]", course[count]) != 1) return;
    printf("Enter Marks: ");
    scanf("%f", &marks[count]);
    count++;
    printf("Student Added!\n");
}

void display() {
    int i;
    if (count == 0) {
        printf("No Records!\n");
        return;
    }
    for (i = 0; i < count; i++) {
        printf("\nID: %s\n", id[i]);
        printf("Name: %s\n", name[i]);
        printf("Course: %s\n", course[i]);
        printf("Marks: %.2f\n", marks[i]);
    }
}

int search(const char *sid, int i) {
    if (i == count) return -1;
    if (strcmp(id[i], sid) == 0) return i;
    return search(sid, i + 1);
}

void find() {
    char sid[50];
    int i;
    printf("Enter ID: ");
    if (scanf("%49s", sid) != 1) return;
    i = search(sid, 0);
    if (i == -1) {
        printf("Not Found!\n");
    } else {
        printf("Name: %s\n", name[i]);
        printf("Course: %s\n", course[i]);
        printf("Marks: %.2f\n", marks[i]);
    }
}

void update() {
    char sid[50];
    int i;
    printf("Enter ID: ");
    if (scanf("%49s", sid) != 1) return;
    i = search(sid, 0);
    if (i == -1) {
        printf("Not Found!\n");
    } else {
        printf("Enter Name: ");
        fflush(stdout);
        if (scanf(" %49[^\n]", name[i]) != 1) return;
        printf("Enter Course: ");
        fflush(stdout);
        if (scanf(" %49[^\n]", course[i]) != 1) return;
        printf("Enter Marks: ");
        scanf("%f", &marks[i]);
        printf("Updated!\n");
    }
}

void del() {
    char sid[50];
    int i, j;
    printf("Enter ID: ");
    if (scanf("%49s", sid) != 1) return;
    i = search(sid, 0);
    if (i == -1) {
        printf("Not Found!\n");
    } else {
        for (j = i; j < count - 1; j++) {
            strcpy(id[j], id[j + 1]);
            strcpy(name[j], name[j + 1]);
            strcpy(course[j], course[j + 1]);
            marks[j] = marks[j + 1];
        }
        count--;
        printf("Deleted!\n");
    }
}

void average() {
    int i;
    float total = 0;
    if (count == 0) {
        printf("No Records!\n");
        return;
    }
    for (i = 0; i < count; i++) {
        total += marks[i];
    }
    printf("Average: %.2f\n", total / count);
}

int main() {
    int ch;
    do {
        printf("\n===== Student Record =====\n");
        printf("1. Add\n");
        printf("2. Display\n");
        printf("3. Search\n");
        printf("4. Update\n");
        printf("5. Delete\n");
        printf("6. Average\n");
        printf("0. Exit\n");
        printf("Enter Choice: ");
        scanf("%d", &ch);
        switch (ch) {
            case 1: add();
             break;
            case 2: display();
             break;
            case 3: find();
             break;
            case 4: update();
             break;
            case 5: del();
             break;
            case 6: average();
             break;
            case 0: printf("Thank You!\n");
             break;
            default: printf("Invalid Choice!\n");
        }
    } while (ch != 0);
    return 0;
}

